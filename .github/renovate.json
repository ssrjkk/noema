{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchCategories": ["python"],
      "groupName": "Python dev dependencies",
      "matchPackagePatterns": ["pytest*", "ruff", "mypy", "pre-commit"],
      "automerge": true
    },
    {
      "matchCategories": ["python"],
      "groupName": "Python core dependencies",
      "matchPackagePatterns": ["pydantic*", "fastapi*", "uvicorn*"]
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["major-update"]
    }
  ],
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/Moscow"
}
