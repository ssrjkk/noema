{
  "title": "Noema — Production",
  "schemaVersion": 36,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "constant",
        "label": "Environment",
        "query": "production",
        "current": {
          "text": "production",
          "value": "production"
        },
        "hide": 0
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Tenant",
        "query": "label_values(noema_requests_total, tenant)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "all",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "rate(noema_requests_total[$__rate_interval])",
          "legendFormat": "{{endpoint}}",
          "interval": "",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 10,
        "minVizWidth": 0
      },
      "description": "Requests per second by endpoint"
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(noema_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "interval": "",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(noema_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "interval": "",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(noema_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "interval": "",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Request latency percentiles over 5m windows"
    },
    {
      "id": 3,
      "title": "Task Success Rate",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "noema_tasks_successful / noema_tasks_processed * 100",
          "legendFormat": "Success Rate",
          "interval": "",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "#EAAA0A", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "description": "Percentage of tasks completed successfully (green > 95%, yellow > 80%, red < 80%)"
    },
    {
      "id": 4,
      "title": "Active Tasks",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "noema_tasks_active",
          "legendFormat": "Active Tasks",
          "interval": "",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAAA0A", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "description": "Number of tasks currently being processed"
    },
    {
      "id": 5,
      "title": "LLM Calls & Tokens",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "rate(noema_llm_calls_total[5m])",
          "legendFormat": "Calls {{provider}}",
          "interval": "",
          "exemplar": true
        },
        {
          "expr": "rate(noema_llm_tokens_total[5m])",
          "legendFormat": "Tokens {{provider}}",
          "interval": "",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tokens"
            },
            "properties": [
              { "id": "custom.transform", "value": "negative-y" }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "LLM call rate (positive) and token consumption rate (negative, stacked)"
    },
    {
      "id": 6,
      "title": "Circuit Breaker Status",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "noema_circuit_breaker_state",
          "legendFormat": "{{provider}}={{state}}",
          "interval": "",
          "format": "table",
          "instant": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAAA0A", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "minWidth": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "State"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "State",
            "desc": false
          }
        ]
      },
      "description": "Circuit breaker state per provider (0=closed, 1=open, 2=half-open)"
    },
    {
      "id": 7,
      "title": "Redis / DB Health",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "noema_infra_healthy{component=\"redis\"}",
          "legendFormat": "Redis",
          "interval": "",
          "exemplar": true
        },
        {
          "expr": "noema_infra_healthy{component=\"postgresql\"}",
          "legendFormat": "PostgreSQL",
          "interval": "",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "description": "Infrastructure component health — 0 = down, 1 = up"
    },
    {
      "id": 8,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "expr": "rate(noema_errors_total[5m])",
          "legendFormat": "Errors/s",
          "interval": "",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Error rate per second with threshold line at 0.01 (1%)"
    }
  ]
}
