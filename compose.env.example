# Noema Docker Compose Environment
# Copy this file to compose.env and set secure values before running docker-compose

# Database password (REQUIRED - use a strong random password)
POSTGRES_PASSWORD=change_me_to_strong_password

# Redis password (REQUIRED - use a strong random password)
REDIS_PASSWORD=change_me_to_strong_password

# API key for authentication (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOEMA_API__API_KEY=

# LLM provider configuration
NOEMA_LLM__PROVIDER=fallback
# NOEMA_LLM__OPENAI_API_KEY=
# NOEMA_LLM__ANTHROPIC_API_KEY=

# Enable neurosymbolic verification (requires Z3)
NOEMA_NS__ENABLED=false

# Webhook secret for incident ingestion
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOEMA_API__WEBHOOK_SECRET=
