# Copy to compose.env and adjust before `docker compose up`.

# PostgreSQL credentials (defaults fall back to dev creds "noema")
POSTGRES_PASSWORD=change-me

# Redis password
REDIS_PASSWORD=change-me

# API
NOEMA_API__HOST=0.0.0.0
NOEMA_API__PORT=8000
NOEMA_API__API_KEY=change-me
NOEMA_API__WEBHOOK_SECRET=change-me

# Grid federation (optional): peer nodes for sub-task delegation
# NOEMA_FEDERATION__PEERS=["10.0.0.2:50051","10.0.0.3:50051"]
# Node-local contribution ledger (JSONL)
# NOEMA_WORKER_LEDGER_PATH=/data/ledger.jsonl